{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lemur-browser-bridge-poc",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "RESULTS", "class_name": "ResultStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ResultStore"] }
  ]
}
