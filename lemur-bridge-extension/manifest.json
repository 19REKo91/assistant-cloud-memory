{
  "manifest_version": 3,
  "name": "Lemur Command Bridge (Prototype)",
  "version": "0.1.1",
  "description": "A narrow proof of concept: receive one allowlisted public-page navigation command from this repository and show its result locally.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/19REKo91/assistant-cloud-memory/*",
    "https://lemur-browser-bridge-poc.flourish-gerbil.workers.dev/*",
    "https://example.com/*",
    "https://www.iana.org/help/example-domains*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lemur Command Bridge",
    "default_popup": "popup.html"
  }
}
