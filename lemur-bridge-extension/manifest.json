{
  "manifest_version": 3,
  "name": "Lemur Command Bridge (Prototype)",
  "version": "0.1.9",
  "description": "A narrow proof of concept for checking approved public-page navigation and its locally recorded result.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/19REKo91/assistant-cloud-memory/*",
    "https://lemur-browser-bridge-poc.flourish-gerbil.workers.dev/*",
    "https://example.com/*",
    "https://www.iana.org/help/example-domains*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "diagnostics.html",
  "action": {
    "default_title": "Lemur Command Bridge — open diagnostics"
  }
}
